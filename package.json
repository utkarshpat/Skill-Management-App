{
  "name": "capability-platform",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "npm run start -w apps/api",
    "package:azure": "node scripts/package-appservice.mjs",
    "dev": "concurrently -k -n api,web \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "node --test scripts/architecture.test.mjs scripts/package-appservice.test.mjs scripts/coverage-source.test.mjs && npm run test -w apps/api && npm run test -w apps/web",
    "test:coverage": "node --test scripts/architecture.test.mjs scripts/package-appservice.test.mjs scripts/coverage-source.test.mjs && node scripts/test-coverage.mjs",
    "test:e2e": "playwright test",
    "coverage:browser": "node scripts/merge-browser-coverage.mjs",
    "architecture:check": "node scripts/check-architecture.mjs",
    "docs:generate": "python scripts/generate-handover.py",
    "docs:check": "python scripts/generate-handover.py --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage:check": "node scripts/check-coverage.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "c8": "9.1.0",
    "concurrently": "10.0.6",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "v8-to-istanbul": "9.3.0",
    "prettier": "^3.9.9"
  }
}
