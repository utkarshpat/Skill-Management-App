{
  "name": "capability-platform",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "node --test scripts/architecture.test.mjs && npm run test -w apps/api && npm run test -w apps/web",
    "architecture:check": "node scripts/check-architecture.mjs",
    "docs:generate": "python scripts/generate-handover.py",
    "docs:check": "python scripts/generate-handover.py --check",
    "db:generate": "npm run db:generate -w apps/api",
    "db:validate": "npm run db:validate -w apps/api",
    "db:schema:check": "npm run db:schema:check -w apps/api",
    "db:migration:new": "npm run db:migration:new -w apps/api --",
    "db:diff": "npm run db:diff -w apps/api",
    "db:status": "npm run db:status -w apps/api",
    "db:baseline": "npm run db:baseline -w apps/api",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "10.0.5",
    "prettier": "^3.9.9"
  }
}
