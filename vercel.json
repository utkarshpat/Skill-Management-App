{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "express",
      "entrypoint": "app.ts",
      "buildCommand": "npm run build",
      "functions": {
        "app.ts": { "includeFiles": "package.json" }
      }
    },
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/:page(access|workspace|profile|my-skills|certifications|skills|skill-reviews|learning|requests|business|preview|knowledgetransfer)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    { "source": "/api", "destination": { "service": "api" } },
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
