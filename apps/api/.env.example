# SQL setup and API runtime configuration.
# Use ignored .env files locally. Never commit credentials.
PORT=3001
NODE_ENV=development
# Optional local demo only. Production must omit or set false.
DEV_DIRECT_LOGIN=false
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_WEB_CLIENT_ID=
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=
# Local runtime uses a restricted service principal, never the developer's SQL owner identity.
AZURE_SQL_RUNTIME_AUTH=client-secret
AZURE_SQL_CLIENT_ID=
AZURE_SQL_CLIENT_SECRET=
# Azure hosting: set runtime auth to managed-identity and grant its restricted SQL user.
AZURE_SQL_MANAGED_IDENTITY_CLIENT_ID=
# Secrets belong only in ignored local files or Azure secret management.
