# SQL setup and API runtime configuration.
# Use ignored .env files locally. Never commit credentials.
PORT=3001
NODE_ENV=development
# Optional local demo only. Production must omit or set false.
DEV_DIRECT_LOGIN=false
# Trusted access-workspace account UUID, provisioned by the explicit import command.
ACCESS_ACCOUNT_ID=
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_WEB_CLIENT_ID=
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=
# Local runtime uses a restricted service principal, never the developer's SQL owner identity.
AZURE_SQL_RUNTIME_AUTH=client-secret
AZURE_SQL_CLIENT_ID=
AZURE_SQL_CLIENT_SECRET=
# Azure hosting: set runtime auth to managed-identity and grant its restricted SQL user.
AZURE_SQL_MANAGED_IDENTITY_CLIENT_ID=
# Secrets belong only in ignored local files or Azure secret management.

# Optional read-only AI assistant. Leave blank to keep the model disconnected.
# Providers: gemini, azure, openai, ollama. AI_MODEL is the Azure deployment name for azure.
AI_PROVIDER=
AI_MODEL=
# Azure: https://YOUR-RESOURCE.openai.azure.com ; Ollama: http://127.0.0.1:11434
AI_ENDPOINT=
# Server only; never put this in VITE_* variables.
AI_API_KEY=
# GEMINI_API alone selects Gemini with gemini-3.8-flash; AI_MODEL can override it.
# GEMINI_API_KEY is also accepted. Only synthetic data for free-tier evaluation.
GEMINI_API=
