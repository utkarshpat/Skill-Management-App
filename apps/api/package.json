{
  "name": "@capability/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts",
    "db:validate": "node node_modules/prisma/build/index.js validate --schema prisma/schema.prisma",
    "db:generate": "node node_modules/prisma/build/index.js generate --schema prisma/schema.prisma",
    "db:diff": "node node_modules/prisma/build/index.js migrate diff --from-empty --to-schema prisma/schema.prisma --script",
    "db:migrate:diff": "node node_modules/prisma/build/index.js migrate diff --from-empty --to-schema prisma/schema.prisma",
    "db:check": "node --env-file-if-exists=.env --import tsx src/database-cli.ts check",
    "db:status": "node --env-file-if-exists=.env --import tsx src/database-cli.ts status",
    "db:baseline": "node --env-file-if-exists=.env --import tsx src/database-cli.ts baseline",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/database-cli.ts migrate",
    "access:presets": "node --env-file-if-exists=.env --import tsx src/role-presets-cli.ts",
    "access:import": "node --env-file-if-exists=.env --import tsx src/access-import-cli.ts",
    "test:organization": "node --env-file-if-exists=.env --import tsx test/organization.integration.ts",
    "test:catalogue": "node --env-file-if-exists=.env --import tsx test/skill-catalogue.integration.ts",
    "test:sql": "node --env-file-if-exists=.env --import tsx test/sql-access.integration.ts",
    "test:employment": "node --env-file-if-exists=.env --import tsx test/employment.integration.ts",
    "test:primary-capability": "node --env-file-if-exists=.env --import tsx test/primary-capability.integration.ts",
    "test:actor-access": "node --env-file-if-exists=.env --import tsx test/actor-access.integration.ts",
    "bench:access": "node --env-file-if-exists=.env --import tsx test/access-read-benchmark.ts",
    "test:reviews": "node --env-file-if-exists=.env --import tsx test/reviews.integration.ts",
    "test:evidence-snapshot": "node --env-file-if-exists=.env --import tsx test/evidence-snapshot.integration.ts",
    "test:review-access": "node --env-file-if-exists=.env --import tsx test/review-access.integration.ts",
    "test:audit-fixes": "node --env-file-if-exists=.env --import tsx test/audit-fixes.integration.ts",
    "test:claims": "node --env-file-if-exists=.env --import tsx test/claims.integration.ts",
    "test:conversations": "node --env-file-if-exists=.env --import tsx test/conversations.integration.ts",
    "catalogue:seed": "node --env-file-if-exists=.env --import tsx src/catalogue-seed-cli.ts",
    "test:framework": "node --env-file-if-exists=.env --import tsx test/framework.integration.ts",
    "test:recommendations": "node --env-file-if-exists=.env --import tsx test/recommendations.integration.ts",
    "test:learning": "node --env-file-if-exists=.env --import tsx test/learning.integration.ts",
    "test:recovery": "node --env-file-if-exists=.env --import tsx test/learning-recovery.integration.ts",
    "test:practice": "node --env-file-if-exists=.env --import tsx test/learning-practice.integration.ts",
    "test:workflows": "node --env-file-if-exists=.env --import tsx test/workflows.integration.ts",
    "test:lifecycle": "node --env-file-if-exists=.env --import tsx test/workflow-lifecycle.integration.ts"
  },
  "dependencies": {
    "@azure/identity": "4.13.3",
    "@azure/storage-blob": "12.34.0",
    "@prisma/client": "^7.10.0",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "mssql": "12.7.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/mssql": "12.3.0",
    "@types/node": "26.6.4",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
