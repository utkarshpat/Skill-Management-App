teamMemberships TeamMembership[]

  @@id([account_id, team_id])
  @@unique([account_id, department_id, display_name])
}

model TeamMembership {
  account_id String @db.UniqueIdentifier
  membership_id String @db.UniqueIdentifier @default(dbgenerated("NEWSEQUENTIALID()"))
  user_id String @db.UniqueIdentifier
  team_id String @db.UniqueIdentifier
  valid_from DateTime
  valid_until DateTime?

  appUser AppUser @relation(fields: [account_id, user_id], references: [account_id, user_id], onDelete: NoAction, onUpdate: NoAction)
  team Team @relation(fields: [account_id, team_id], references: [account_id, team_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([account_id, membership_id])
}

model UserPermission {
  account_id String @db.UniqueIdentifier
  grant_id String @db.UniqueIdentifier @default(dbgenerated("NEWSEQUENTIALID()"))
  user_id String @db.UniqueIdentifier
  permission_code String @db.VarChar(100)
  effect String @db.VarChar(5)
  scope_kind String @db.VarChar(30)
  scope_id String? @db.UniqueIdentifier
  resource_type String? @db.VarChar(100)
  valid_from DateTime
  valid_until DateTime?
  reason String @db.NVarChar(1000)
  granted_by String @db.UniqueIdentifier
  revoked_at DateTime?
  revoked_by String? @db.UniqueIdentifier
  revoke_reason String? @db.NVarChar(1000)
  created_at DateTime @default(now())
  record_version Bytes @db.Binary(8) @default(dbgenerated())

  permission Permission @relation(fields: [permission_code], references: [permission_code], onDelete: NoAction, onUpdate: NoAction)
  user AppUser @relation("UserPermission_AppUser_user", fields: [account_id, user_id], references: [account_id, user_id], onDelete: NoAction, onUpdate: NoAction)
  granted_byRel AppUser @relation("UserPermission_AppUser_granted_by", fields: [account_id, granted_by], references: [account_id, user_id], onDelete: NoAction, onUpdate: NoAction)
  revoked_byRel AppUser? @relation("UserPermission_AppUser_revoked_by", fields: [account_id, revoked_by], references: [account_id, user_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([account_id, grant_id])
  @@index([account_id, user_id, permission_code, valid_from, valid_until], map: "IX_Permission_User")
}

model UserRole {
  account_id String @db.UniqueIdentifier
  assignment_id String @db.UniqueIdentifier @default(dbgenerated("NEWSEQUENTIALID()"))
  user_id String @db.UniqueIdentifier
  role_code String @db.VarChar(40)
  valid_from DateTime
  valid_until DateTime?
  revoked_at DateTime?
  granted_by String @db.UniqueIdentifier

  appRole AppRole @relation(fields: [role_code], references: [role_code], onDelete: NoAction, onUpdate: NoAction)
  user AppUser @relation("UserRole_AppUser_user", fields: [account_id, user_id], references: [account_id, user_id], onDelete: NoAction, onUpdate: NoAction)
  granted_byRel AppUser @relation("UserRole_AppUser_granted_by", fields: [account_id, granted_by], references: [account_id, user_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([account_id, assignment_id])
}

model WorkflowEvent {
  account_id String @db.UniqueIdentifier
  record_id String @db.UniqueIdentifier
  event_id String @db.UniqueIdentifier
  revision Int
  actor_id String @db.UniqueIdentifier
  action String @db.VarChar(20)
  body String @db.NVarChar(1000)
  occurred_at DateTime @default(now())
  base_revision Int?
  target_recipient_id String? @db.UniqueIdentifier

  workflowRecord WorkflowRecord @relation(fields: [account_id, record_id], references: [account_id, record_id], onDelete: NoAction, onUpdate: NoAction)
  actor AccessPerson @relation("WorkflowEvent_AccessPerson_actor", fields: [account_id, actor_id], references: [account_id, person_id], onDelete: NoAction, onUpdate: NoAction)
  target_recipient AccessPerson? @relation("WorkflowEvent_AccessPerson_target_recipient", fields: [account_id, target_recipient_id], references: [account_id, person_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([account_id, event_id])
  @@unique([account_id, record_id, revision])
}

model WorkflowRecord {
  account_id String @db.UniqueIdentifier
  record_id String @db.UniqueIdentifier
  kind String @db.VarChar(8)
  requester_id String @db.UniqueIdentifier
  recipient_id String @db.UniqueIdentifier
  title String @db.NVarChar(160)
  description String @db.NVarChar(2000)
  priority String @db.VarChar(6)
  status String @db.VarChar(20)
  revision Int
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  category String @db.VarChar(24)
  record_number BigInt @default(autoincrement())

  requester AccessPerson @relation("WorkflowRecord_AccessPerson_requester", fields: [account_id, requester_id], references: [account_id, person_id], onDelete: NoAction, onUpdate: NoAction)
  recipient AccessPerson @relation("WorkflowRecord_AccessPerson_recipient", fields: [account_id, recipient_id], references: [account_id, person_id], onDelete: NoAction, onUpdate: NoAction)

workflowEvents WorkflowEvent[]

  @@id([account_id, record_id])
  @@index([account_id, requester_id, updated_at], map: "IX_WorkflowOwner")
  @@index([account_id, recipient_id, updated_at], map: "IX_WorkflowRecipient")
  @@unique([record_number], map: "UX_Workflow_Reference")
}
